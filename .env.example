# Copie para .env.local e preencha. Nunca commite valores reais.

# Firebase (cliente): valores públicos do app web, do console do Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor): da chave de conta de serviço. Só na Vercel e no .env.local
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Ambiente de teste: permite BUs simulados/treinamento (FASE:S ou T). Nunca "true" em produção.
PERMITIR_BU_TESTE=

# Liga o SDK do navegador nos emuladores locais (Firestore/Auth/Storage em 127.0.0.1). Nunca "true" em produção.
NEXT_PUBLIC_USE_EMULATORS=

# Leitura da foto do boletim por IA (opcional — sem isso, o botão "Tentar ler com IA" só mostra um
# aviso de que não está configurado, o resto do app funciona normal). Chave do Google AI Studio
# (aistudio.google.com/apikey). Só no servidor, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=
